local function SafeTeleport(targetPos, keepAnchored)
    local hrp = GetHRP()
    if not hrp or not targetPos then return end

    local targetCF: CFrame
    if typeof(targetPos) == "CFrame" then
        targetCF = targetPos
    else
        targetCF = CFrame.new(targetPos)
    end

    local currentDist = (hrp.Position - targetCF.Position).Magnitude
    if currentDist > 2.5 then
        hrp.CFrame = targetCF
        if keepAnchored then
            hrp.Anchored = true
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        else
            hrp.Anchored = false
        end
        task.wait(0.2)
    end
end

