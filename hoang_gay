        if not afReady or lastAutoFarmZone ~= targetZone then
            local afOk = EnsureAutoFarmActiveAtZone(targetZone)
            if not afOk then
                warn(string.format("[auto boss] Zone %d AutoFarm not ready -> Delay boss cycle.", targetZone))
                return 0
            end
        end
    end

    runState.isFightingBoss = true
    local info = BOSS_INFO[targetZone]
    local minCoinsToFight = info and info.MinCoins or 98000
    local fightCountInCycle = 0
    local cycleStartCoins = GetCoins()

    local inst = GetHatchWarInstance()
    local bossSpot = info and info.Spot
    local bFolder = inst and inst.model and inst.model:FindFirstChild("INTERACT")
        and inst.model.INTERACT:FindFirstChild("Bosses")
        and inst.model.INTERACT.Bosses:FindFirstChild("Boss" .. tostring(targetZone))
    if bFolder and bFolder:FindFirstChild("Idle") then
        bossSpot = bFolder.Idle.CFrame + Vector3.new(0, 2, 0)
    end
    if bossSpot then
        local hrp = GetHRP()
        if not hrp or (hrp.Position - bossSpot.Position).Magnitude > 6 then
            SafeTeleport(bossSpot)
            task.wait(0.3)
        end
        hrp = GetHRP()
        if hrp then hrp.Anchored = true end
    end

    local bossFarmActive = true
    local netDamage = game:GetService("ReplicatedStorage").Network:FindFirstChild("Breakables_PlayerDealDamage")

    StartAutoTapWorker(targetZone, function()
        return bossFarmActive
    end)

    task.spawn(function()
        while Running() and bossFarmActive do
            local valid = GetZoneBreakables(targetZone)
            local pets = GetLocalPets()

            if #valid > 0 and #pets > 0 then
                for i, pet in ipairs(pets) do
                    local targetBreakable = valid[((i - 1) % #valid) + 1]
                    if targetBreakable and targetBreakable.Parent then
                        pcall(function()
                            if pet:GetTarget() ~= targetBreakable then
                                pet:SetTarget(targetBreakable)
                            end
                        end)
                    end
                end
            end
            task.wait(0.18)
        end
    end)

    local lastIntermissionCheck = os.clock()
    while Running() and GetCoins() >= minCoinsToFight do
        fightCountInCycle = fightCountInCycle + 1

        AutoUseEventBoosters()

        local success = FightBossAtZone(targetZone, true)

        if os.clock() - lastIntermissionCheck >= 30 then
            lastIntermissionCheck = os.clock()
            PerformEventIntermissions()
        end

        if not success then

            task.wait(1.0)
        else

            task.wait(0.25)
        end

        PerformEventIntermissions()

        if GetCoins() < minCoinsToFight then
            break
        end
    end

    bossFarmActive = false
    runState.isFightingBoss = false
    return fightCountInCycle
end

local function HatchEndGameCycleLoop()

    if HasAutoFarmGamepass() and IsMaxZoneUnlocked() then
        local targetZone = CONFIG.EndGame.TargetZone or 6
        local afReady = AutoFarmCmds and AutoFarmCmds.IsEnabled and AutoFarmCmds.IsEnabled()
        if not afReady or lastAutoFarmZone ~= targetZone then
            local afOk = EnsureAutoFarmActiveAtZone(targetZone)
            if not afOk then
                warn(string.format("[auto hatch] Zone %d AutoFarm not ready -> Delay hatch cycle.", targetZone))
                return 0
            end
        end
    end

    runState.isHatching = true
    if not CustomEggsCmds or not Network then
        runState.isHatching = false
        task.wait(1)
        return 0
    end

    CheckAndBuyEggSlots()

    AutoUseEventBoosters()

    local eggName = CONFIG.EndGame.EggName or "Manor Egg"
    local HATCH_STAND_CFRAME = EGG_STAND_CFRAMES[eggName] or (CONFIG.EndGame.EggSpot and CFrame.new(CONFIG.EndGame.EggSpot)) or CFrame.new(7537.90, 16.21, 21962.36)
    SafeTeleport(HATCH_STAND_CFRAME)
    task.wait(0.3)
    local hrp = GetHRP()
    if hrp then hrp.Anchored = true end

    local eggUid = CustomEggsCmds.GetClosestById and CustomEggsCmds.GetClosestById(CONFIG.EndGame.EggName)
    local eggUnitPrice = 98000
    pcall(function()
        local CalcEggPricePlayer = LoadModule(Library, "Balancing.CalcEggPricePlayer")
        local eggData = eggUid and CustomEggsCmds.Get(eggUid)
        if eggData and CalcEggPricePlayer then
            eggUnitPrice = CalcEggPricePlayer(eggData:Directory()) or 98000
        end
    end)

    local maxHatch = (EggCmds and EggCmds.GetMaxHatch and EggCmds.GetMaxHatch()) or 8
    local hatchBatches = 0
    local lastHatchPrint = 0
    local hatchFarmActive = true
    local netDamage = game:GetService("ReplicatedStorage").Network:FindFirstChild("Breakables_PlayerDealDamage")
    local targetFarmZone = CONFIG.EndGame.TargetZone or 6

    StartAutoTapWorker(targetFarmZone, function()
        return hatchFarmActive
    end)

    task.spawn(function()
        while Running() and hatchFarmActive do
            local valid = GetZoneBreakables(targetFarmZone)
            local pets = GetLocalPets()

            if #valid > 0 and #pets > 0 then
                for i, pet in ipairs(pets) do
                    local targetBreakable = valid[((i - 1) % #valid) + 1]
                    if targetBreakable and targetBreakable.Parent then
                        pcall(function()
                            if pet:GetTarget() ~= targetBreakable then
                                pet:SetTarget(targetBreakable)
                            end
                        end)
                    end
                end
            end
            task.wait(0.15)
        end
    end)

    local failedStreak = 0
    local lastIntermissionCheck = os.clock()
    while Running() and GetCoins() >= eggUnitPrice do
        if not eggUid then
            eggUid = CustomEggsCmds.GetClosestById and CustomEggsCmds.GetClosestById(CONFIG.EndGame.EggName)
        end

        local curCoins = GetCoins()
        maxHatch = (EggCmds and EggCmds.GetMaxHatch and EggCmds.GetMaxHatch()) or maxHatch

        local maxAffordable = math.floor(curCoins / eggUnitPrice)
        local batchAmount = math.min(maxHatch, maxAffordable)

        if batchAmount <= 0 then
            break
        end

        local success = false
        if eggUid then
            local ok, res = pcall(function()
                return Network.Invoke("CustomEggs_Hatch", eggUid, batchAmount)
            end)
            if ok and res ~= false then
                success = true
                failedStreak = 0
                hatchBatches = hatchBatches + 1
            else
                failedStreak = failedStreak + 1
            end
        end

        if not success and failedStreak >= 2 then

            SafeTeleport(HATCH_STAND_CFRAME)
            task.wait(0.2)
        end

        if os.clock() - lastIntermissionCheck >= 30 then
            lastIntermissionCheck = os.clock()
            PerformEventIntermissions()
        end

        task.wait(0.12)

        if os.clock() - lastHatchPrint > 3 or hatchBatches == 1 then
            lastHatchPrint = os.clock()
            print(string.format("[auto map] Zone %d || Hatch: #%d (x%d) || %s || Coins: %s || cycle: %d",
                CONFIG.EndGame.TargetZone or 6, hatchBatches, batchAmount, CONFIG.EndGame.EggName, FormatNumber(GetCoins()), currentCycle))
        end
    end

    hatchFarmActive = false
    task.wait(0.1)
    hrp = GetHRP()
    if hrp then hrp.Anchored = false end

    runState.isHatching = false
    return hatchBatches
end

local function StartBloodMoonWatcher()
    task.spawn(function()
        local lastMoonState = "down"
        while Running() do
            pcall(function()
                if EnsureInHatchWar() then
                    local state = GetBloodMoonState()
                    if state ~= lastMoonState then
                        lastMoonState = state
                        if state == "up" then
                            print("[blood moon] Blood Moon RISE (3x Luck, 2x Huge/Titanic).")
                        elseif state == "warn" then
                            local nextRise = GetBloodMoonNextRise()
                            local timeLeft = nextRise and math.max(0, math.ceil(nextRise - workspace:GetServerTimeNow())) or 300
                            print(string.format("[blood moon] Blood Moon in %ds", timeLeft))
                        end
                    end
                end
            end)
            task.wait(4)
        end
    end)
end

local function StartLeaguePatrolWorker()
    if not CONFIG.League or not CONFIG.League.Enabled then return end
    task.spawn(function()
        local lastScanTime = 0
        while Running() do
            local interval = CONFIG.League.ScanInterval or 2.5
            if os.clock() - lastScanTime >= interval then
                lastScanTime = os.clock()

                CheckAndPlaceGiantCandyChests()

                local allChests = FindAllEventChests()
                if #allChests > 0 then
                    local moonState = GetBloodMoonState()
                    local isBloodMoon = (moonState == "up")
                    print(string.format("[league] Radar: %d chests found (BloodMoon: %s)",
                        #allChests, tostring(isBloodMoon)))
                    for _, chest in ipairs(allChests) do
                        if not Running() then break end
                        BreakTargetChest(chest, 25)
                        task.wait(0.2)
                    end
                end
            end

            task.wait(0.5)
        end
    end)
end

local function StartMainAutomationLoop()
    task.spawn(function()
        while Running() do
            if not EnsureInHatchWar() then
                task.wait(1.5)
                continue
            end

            local maxZone = GetCurrentMaxUnlockedZone()
            local targetZone = CONFIG.EndGame.TargetZone or 6

            if maxZone < targetZone then
                local bossToBeat = maxZone
                local info = BOSS_INFO[bossToBeat]

                print(string.format("[auto map] Zone %d/%d || Boss %d: %s",
                    maxZone, targetZone, bossToBeat, info and info.Name or "?"))

                FightBossAtZone(bossToBeat)

                task.wait(0.5)
                local newMax = GetCurrentMaxUnlockedZone()
                if newMax > maxZone then
                    print(string.format("[auto map] Unlocked Zone %d", newMax))
                end
            else

                EnforceEndGameExclusivity()

                local curCoins = GetCoins()
                local targetCoins = CONFIG.EndGame.TargetCoins or 1_000_000_000
                local hasAutoFarm = HasAutoFarmGamepass()

                if hasAutoFarm and IsMaxZoneUnlocked() then
                    local autoFarmActive = EnsureAutoFarmActiveAtZone(targetZone)
                    if not autoFarmActive then
                        print(string.format("[auto farm] Zone %d not ready -> Retrying before EndGame...", targetZone))
                        task.wait(1.0)
                        continue
                    end
                end

                if CONFIG.EndGame.Boss == true then
                    local info = BOSS_INFO[targetZone]
                    local minCoinsToFight = info and info.MinCoins or 98000

                    local minBufferCoins = math.min(targetCoins * 0.3, 300_000_000)

                    if curCoins < minBufferCoins or curCoins < minCoinsToFight then
                        print(string.format("[auto map] Coins low (%s < %s) -> Farming Zone %d",
                            FormatNumber(curCoins), FormatNumber(targetCoins), targetZone))
                        FarmBreakablesUntil(targetCoins, targetCoins, targetZone)
                    else

                        PerformEventIntermissions()

                        BossEndGameCycleLoop(targetZone)
                        ClearCycleCache(currentCycle)
                        currentCycle = currentCycle + 1

                        PerformEventIntermissions()
                    end
                elseif CONFIG.EndGame.Hatch == true then
                    if curCoins < targetCoins then
                        FarmBreakablesUntil(targetCoins, targetCoins, targetZone)
                    else
                        PerformEventIntermissions()
                        HatchEndGameCycleLoop()
                        ClearCycleCache(currentCycle)
                        currentCycle = currentCycle + 1
                        PerformEventIntermissions()
                    end
                else
                    PerformEventIntermissions()
                    task.wait(1)
                end
            end

            task.wait(0.2)
        end
    end)
end

