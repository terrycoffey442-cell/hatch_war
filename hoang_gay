local function FindAllEventChests()
    local chests = {}
    local things = workspace:FindFirstChild("__THINGS")
    local bFolder = things and things:FindFirstChild("Breakables")
    local hrp = GetHRP()
    local myPos = hrp and hrp.Position

    if bFolder then
        for _, b in ipairs(bFolder:GetChildren()) do
            if b:IsA("Model") and b.Name ~= "Highlight" then
                if IsChestBreakable(b) then
                    table.insert(chests, b)
                end
            end
        end
    end

    pcall(function()
        local CandyChest = LoadModule(Client, "HatchWarCmds") and LoadModule(Client.HatchWarCmds, "CandyChest")
        if CandyChest and CandyChest.State then
            local uvs = debug.getupvalues(CandyChest.State)
            local u58 = uvs and uvs[1]
            if type(u58) == "table" then
                for _, item in pairs(u58) do
                    local b = item.Breakable and item.Breakable.model
                    if b and b.Parent and b:IsA("Model") and not table.find(chests, b) then
                        table.insert(chests, b)
                    end
                end
            end
        end
    end)

    if #chests > 1 and myPos then
        table.sort(chests, function(a, b)
            local aCandy = (a:GetAttribute("CandyChest") == true)
            local bCandy = (b:GetAttribute("CandyChest") == true)
            if aCandy and not bCandy then return true end
            if not aCandy and bCandy then return false end

            local pA = a:GetPivot()
            local pB = b:GetPivot()
            local distA = pA and (pA.Position - myPos).Magnitude or 9999
            local distB = pB and (pB.Position - myPos).Magnitude or 9999
            return distA < distB
        end)
    end

    return chests
end

