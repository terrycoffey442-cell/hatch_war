local function CheckAndBuyEggSlots()
    if not CONFIG.AutoBuyEggSlots then return end
    pcall(function()
        local SaveMod = LoadModule(Client, "Save")
        local RankCmds = LoadModule(Client, "RankCmds")
        local CurrencyCmds = LoadModule(Client, "CurrencyCmds")
        local Balancing = LoadModule(Library, "Balancing")

        if not SaveMod or not RankCmds or not Network then return end

        local save = SaveMod.Get()
        if not save then return end

        local purchased = save.EggSlotsPurchased or 0
        local maxPurchasable = (RankCmds.GetMaxPurchasableEggSlots and RankCmds.GetMaxPurchasableEggSlots()) or 0

        if purchased < maxPurchasable then
            local nextSlot = purchased + 1
            while nextSlot <= maxPurchasable and Running() do
                local bundleEnd, bundleSize, prevBundleEnd = RankCmds.GetEggBundle(nextSlot)
                if not bundleEnd or bundleEnd <= purchased then break end

                local cost = 0
                if Balancing and Balancing.CalcEggSlotPrice then
                    local startSlot = bundleEnd - bundleSize
                    for i = 1, bundleSize do
                        cost = cost + Balancing.CalcEggSlotPrice(startSlot + i)
                    end
                end

                local diamonds = (CurrencyCmds and CurrencyCmds.Get and CurrencyCmds.Get("Diamonds")) or 0
                if diamonds >= cost then
                    local success = Network.Invoke("EggHatchSlotsMachine_RequestPurchase", bundleEnd)
                    if success then

                        purchased = bundleEnd
                        nextSlot = bundleEnd + 1
                        task.wait(0.2)
                    else
                        break
                    end
                else
                    break
                end
            end
        end
    end)
end

