    end
    return false
end

local function GetZoneBreakables(zoneNum)
    local valid = {}
    local things = workspace:FindFirstChild("__THINGS")
    local bFolder = things and things:FindFirstChild("Breakables")
    if not bFolder then return valid end

    local targetCF = GetZoneGroundCFrame(zoneNum or 6)
    local zPos = targetCF.Position
    local targetArea = "Main_" .. tostring(zoneNum or 6)

    for _, b in ipairs(bFolder:GetChildren()) do
        if b:IsA("Model") and b.Name ~= "Highlight" then
            local area = b:GetAttribute("AreaID")
            if area == targetArea then
                table.insert(valid, b)
            elseif not area and b:GetPivot() then
                local dist = (b:GetPivot().Position - zPos).Magnitude
                if dist <= 85 then
                    table.insert(valid, b)
                end
            end
        end
    end

    if CONFIG.League and CONFIG.League.PrioritizeChests and #valid > 1 then
        table.sort(valid, function(a, b)
            local aIs = IsChestBreakable(a)
            local bIs = IsChestBreakable(b)
            if aIs and not bIs then return true end
            if not aIs and bIs then return false end
            return false
        end)
    end

    return valid
end

local function StartAutoTapWorker(getZoneOrZoneNum, isRunningCheck)
    local netDamage = game:GetService("ReplicatedStorage").Network:FindFirstChild("Breakables_PlayerDealDamage")
    if not netDamage then return end

    task.spawn(function()
        local currentTarget = nil
        while Running() and (not isRunningCheck or isRunningCheck()) do
            local zone = typeof(getZoneOrZoneNum) == "function" and getZoneOrZoneNum() or getZoneOrZoneNum or 6
            local hrp = GetHRP()
            local pPos = hrp and hrp.Position

            if not currentTarget or not currentTarget.Parent or not currentTarget:IsA("Model") then
                currentTarget = nil
                local valid = GetZoneBreakables(zone)
                if #valid > 0 then

                    if pPos then
                        table.sort(valid, function(a, b)
                            if CONFIG.League and CONFIG.League.PrioritizeChests then
                                local aIs = IsChestBreakable(a)
                                local bIs = IsChestBreakable(b)
                                if aIs and not bIs then return true end
                                if not aIs and bIs then return false end
                            end
                            local pA = a:GetPivot()
                            local pB = b:GetPivot()
                            local distA = pA and (pA.Position - pPos).Magnitude or 9999
                            local distB = pB and (pB.Position - pPos).Magnitude or 9999
                            return distA < distB
                        end)
                    end
                    currentTarget = valid[1]
                end
            end

            if currentTarget and currentTarget.Parent then
                if SignalMod and SignalMod.Fire then
                    SignalMod.Fire("AutoClicker_Nearby", currentTarget.Name)
                else
                    netDamage:FireServer(currentTarget.Name)
                end
            end

            task.wait(0.07)
        end
    end)
end

local function FarmBreakablesUntil(targetCoins, recCoins, zoneNum)
    local targetZone = zoneNum or 6
    local targetCF = GetZoneGroundCFrame(targetZone)

    if CONFIG.EndGame.Hatch == true and targetZone == (CONFIG.EndGame.TargetZone or 6) then
        targetCF = EGG_STAND_CFRAMES[CONFIG.EndGame.EggName or "Manor Egg"] or (CONFIG.EndGame.EggSpot and CFrame.new(CONFIG.EndGame.EggSpot)) or CFrame.new(7537.90, 16.21, 21962.36)
    end

    local hasPass = HasAutoFarmGamepass()
    local targetPct = recCoins and recCoins > 0 and ((targetCoins / recCoins) * 100) or ((CONFIG.RecommendedRatio or 2.00) * 100)
    print(string.format("[auto map] Zone %d || Farming coins: %s / %s (%d%%)",
        targetZone, FormatNumber(GetCoins()), FormatNumber(targetCoins), math.floor(targetPct)))

    SafeTeleport(targetCF)
    task.wait(0.25)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.Anchored = true end

    local farmStart = os.clock()
    local lastPrint = os.clock()

    local autoTapActive = true
    StartAutoTapWorker(targetZone, function()
        return autoTapActive and GetCoins() < targetCoins
    end)

    while Running() and GetCoins() < targetCoins and (os.clock() - farmStart < 90) do
        local valid = GetZoneBreakables(targetZone)
        local pets = GetLocalPets()

        if #valid > 0 and #pets > 0 then
            for i, pet in ipairs(pets) do
                local targetBreakable = valid[((i - 1) % #valid) + 1]
                if targetBreakable and targetBreakable.Parent then
                    pcall(function()
                        if pet:GetTarget() ~= targetBreakable then
                            pet:SetTarget(targetBreakable)
                        end
                    end)
                end
            end
        end

        task.wait(0.15)

        if os.clock() - lastPrint > 3 then
            lastPrint = os.clock()
            local cur = GetCoins()
            local pct = targetCoins > 0 and (cur / targetCoins * 100) or 0
            print(string.format("[auto map] Coins: %s / %s (%.1f%%)",
                FormatNumber(cur), FormatNumber(targetCoins), pct))
        end
    end

    autoTapActive = false

    local finalCoins = GetCoins()
    hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.Anchored = false end

    if finalCoins >= targetCoins then
        print(string.format("[auto map] Coin target reached: %s / %s",
            FormatNumber(finalCoins), FormatNumber(targetCoins)))
    end

    return finalCoins >= targetCoins
end

local function EnsureSufficientCoins(targetCoins, recCoins, zoneNum)
    local coins = GetCoins()
    if coins >= targetCoins then return true end

    return FarmBreakablesUntil(targetCoins, recCoins, zoneNum)
end

