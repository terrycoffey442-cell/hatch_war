local function BreakTargetChest(chestModel, maxDuration)
    if not chestModel or not chestModel.Parent then return false end
    maxDuration = maxDuration or 25
    local chestPivot = chestModel:GetPivot()
    local chestPos = chestPivot and chestPivot.Position
    if not chestPos then return false end

    local chestId = chestModel:GetAttribute("BreakableID") or chestModel.Name
    print(string.format("[league] Target Chest: %s",
        tostring(chestId), chestPos.X, chestPos.Y, chestPos.Z))

    local hrp = GetHRP()
    local oldPos = hrp and hrp.CFrame
    local wasAnchored = hrp and hrp.Anchored

    local standPos = CFrame.new(chestPos + Vector3.new(0, 3, 6))
    SafeTeleport(standPos)
    task.wait(0.2)
    hrp = GetHRP()
    if hrp then hrp.Anchored = true end

    local netDamage = game:GetService("ReplicatedStorage").Network:FindFirstChild("Breakables_PlayerDealDamage")
    local startTime = os.clock()
    local lastTap = 0

    while Running() and chestModel.Parent and (os.clock() - startTime < maxDuration) do

        local pets = GetLocalPets()
        if #pets > 0 then
            for _, pet in ipairs(pets) do
                pcall(function()
                    if pet:GetTarget() ~= chestModel then
                        pet:SetTarget(chestModel)
                    end
                end)
            end
        end

        if netDamage and os.clock() - lastTap >= 0.07 then
            lastTap = os.clock()
            pcall(function()
                if SignalMod and SignalMod.Fire then
                    SignalMod.Fire("AutoClicker_Nearby", chestModel.Name)
                else
                    netDamage:FireServer(chestModel.Name)
                end
            end)
        end

        task.wait(0.07)
    end

    local broken = (not chestModel.Parent)
    if broken then
        print(string.format("[league] Broken Chest: %s (+Points)", tostring(chestId)))
    end

    if oldPos then
        SafeTeleport(oldPos)
        task.wait(0.15)
        local curHrp = GetHRP()
        if curHrp and wasAnchored then
            curHrp.Anchored = true
        end
    end

    return broken
end

local function CheckAndKnockDoors(force)
    if not CONFIG.BloodMoon.AutoKnock then return false end
    if IsBusy() and not force then return false end
    local inst = GetHatchWarInstance()
    if not inst or not inst.InvokeCustom then return false end

    local moonState = GetBloodMoonState()
    local isBloodMoon = (moonState == "up")
    if CONFIG.BloodMoon.OnlyInBloodMoon and not isBloodMoon then
        return false
    end

    local doorsSave = inst:GetSavedValue("Doors")
    local housesSave = inst:GetSavedValue("Houses")
    local maxHouse = (HatchWarDoors and HatchWarDoors.Unlocked and HatchWarDoors.Unlocked(housesSave)) or 1
    local now = workspace:GetServerTimeNow()
    local curCoins = GetCoins()

    local order = {}
    if isBloodMoon and CONFIG.BloodMoon.PrioritizeHouses7And8 then
        for h = maxHouse, 1, -1 do
            table.insert(order, h)
        end
    else
        for h = 1, maxHouse do
            table.insert(order, h)
        end
    end

    local knockedAny = false
    local hrp = GetHRP()
    local returnCF = hrp and hrp.CFrame
    local wasAnchored = hrp and hrp.Anchored

    for _, houseNum in ipairs(order) do
        local cdEnd = (HatchWarDoors and HatchWarDoors.CooldownEnd and HatchWarDoors.CooldownEnd(doorsSave, houseNum)) or 0
        if now >= cdEnd then
            local knockCost = (HatchWarDoors and HatchWarDoors.KnockCost and HatchWarDoors.KnockCost(houseNum)) or 1_000_000
            if curCoins >= knockCost then
                local spot = HOUSE_SPOTS[houseNum]
                if spot then
                    SafeTeleport(spot)
                    task.wait(0.2)
                end

                local ok, res = pcall(function()
                    return inst:InvokeCustom("HW_Doors_Knock", houseNum)
                end)
                if ok and res ~= false then
                    knockedAny = true
                    print(string.format("[blood moon] open_house:%d (BloodMoon: %s)", houseNum, tostring(isBloodMoon)))
                    task.wait(0.3)

                    if CONFIG.League and CONFIG.League.Enabled and CONFIG.League.PostKnockCheck then
                        task.wait(0.4)
                        local streetChests = FindStreetCandyChests()
                        for _, chest in ipairs(streetChests) do
                            local cp = chest:GetPivot() and chest:GetPivot().Position
                            if cp and spot and (cp - spot.Position).Magnitude <= 40 then
                                BreakTargetChest(chest, 30)
                                break
                            end
                        end
                    end
                end
            end
        end
    end

    if knockedAny and returnCF then
        SafeTeleport(returnCF)
        task.wait(0.15)
        local curHrp = GetHRP()
        if curHrp and wasAnchored then
            curHrp.Anchored = true
        end
    end
    return knockedAny
end

