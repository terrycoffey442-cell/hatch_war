local function IsChestBreakable(b)
    if not b or not b:IsA("Model") or not b.Parent then return false end
    local bId = b:GetAttribute("BreakableID")
    if bId and string.find(string.lower(bId), "chest") then
        return true
    end
    local bCls = b:GetAttribute("BreakableClass")
    if bCls and string.find(string.lower(bCls), "chest") then
        return true
    end
    if b:GetAttribute("CandyChest") == true then
        return true
    end
    if string.find(string.lower(b.Name), "chest") then
