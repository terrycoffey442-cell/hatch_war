local function SweepLuckyOrbs(targetBankRatio)
    targetBankRatio = targetBankRatio or 0.85
    local OrbsCmd = LoadModule(Client, "HatchWarCmds") and LoadModule(Client.HatchWarCmds, "Orbs")
    if not OrbsCmd or not OrbsCmd.Bank then return end

    local curBank, maxBank = OrbsCmd.Bank()
    local target = math.floor(maxBank * targetBankRatio)
    if curBank >= target then return end

    local inst = GetHatchWarInstance()
    if not inst then return end

    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    print(string.format("[auto map] Sweeping Orbs: %d / %d (target: %d)", curBank, maxBank, target))
    local oldPos = hrp.CFrame
    local sweepStart = os.clock()

    while Running() and (os.clock() - sweepStart < 12) do
        curBank, maxBank = OrbsCmd.Bank()
        if curBank >= target then break end

        local sync = nil
        pcall(function()
            sync = inst:InvokeCustom("HW_Orbs_Sync")
        end)

        local foundAny = false
        if type(sync) == "table" then
            for id, orb in pairs(sync) do
                curBank, maxBank = OrbsCmd.Bank()
                if curBank >= target then break end

                if orb and orb.Position then
                    foundAny = true
                    SafeTeleport(CFrame.new(orb.Position + Vector3.new(0, 1.5, 0)))
                    task.wait(0.18)
                    pcall(function()
                        inst:InvokeCustom("HW_Orbs_Claim", id)
                    end)
                end
            end
        end

        if not foundAny then
            task.wait(0.4)
        end
    end

    SafeTeleport(oldPos)
    task.wait(0.2)
    local endBank = OrbsCmd.Bank()
    print(string.format("[auto map] Orbs complete: %d / %d", endBank, maxBank, endBank * 1.5))
end

local totalFights = 0
local currentCycle = 1

local function FightBossAtZone(zoneNum, skipCoinCheck)
    local info = BOSS_INFO[zoneNum]
    if not info then return false end

    if not EnsureInHatchWar() then
        task.wait(1.5)
        return false
    end

    local inst = GetHatchWarInstance()
    if not inst or not BossModule then
        task.wait(1)
        return false
    end

    InstallMissBypass(inst)

    local targetCoins, fullRecCoins, recLuck = GetRecommendedTargetCoins(zoneNum)
    if not skipCoinCheck then
        if not EnsureSufficientCoins(targetCoins, fullRecCoins, zoneNum) then
            return false
        end
    else
        if GetCoins() < (info.MinCoins or 98000) then
            return false
        end
    end

    if HasAutoFarmGamepass() and IsMaxZoneUnlocked() then
        local afReady = AutoFarmCmds and AutoFarmCmds.IsEnabled and AutoFarmCmds.IsEnabled()
        if not afReady or lastAutoFarmZone ~= zoneNum then
            local afOk = EnsureAutoFarmActiveAtZone(zoneNum)
            if not afOk then
                warn(string.format("[auto boss] Zone %d AutoFarm not ready -> Delay boss.", zoneNum))
                return false
            end
        end
    end

    runState.isFightingBoss = true

    local bossSpot = info.Spot
    local bFolder = inst.model and inst.model:FindFirstChild("INTERACT")
        and inst.model.INTERACT:FindFirstChild("Bosses")
        and inst.model.INTERACT.Bosses:FindFirstChild("Boss" .. tostring(zoneNum))
    if bFolder and bFolder:FindFirstChild("Idle") then
        bossSpot = bFolder.Idle.CFrame + Vector3.new(0, 2, 0)
    end

    local hrp = GetHRP()
    local isAlreadyAtBoss = hrp and (hrp.Position - bossSpot.Position).Magnitude <= 6
    if not isAlreadyAtBoss then
        SafeTeleport(bossSpot)
        task.wait(0.3)
    end
    hrp = GetHRP()
    if hrp then hrp.Anchored = true end

    pcall(function()
        inst:InvokeCustom("HW_Contests_SetFlameStop", 3)
    end)

    if not BossModule.IsFighting() then
        local ok, err = inst:InvokeCustom("HW_Boss_Start", zoneNum)
        if not ok and tostring(err) ~= "You are already in a boss fight!" then
            SafeTeleport(bossSpot)
            task.wait(0.4)
            inst:InvokeCustom("HW_Boss_Start", zoneNum)
        end

        local waitStart = os.clock()
        while Running() and not BossModule.IsFighting() and (os.clock() - waitStart < 4) do
            task.wait(0.1)
        end
    end

    if not BossModule.IsFighting() then
        ForceCleanupBossFight(skipCoinCheck)
        return false
    end

    totalFights = totalFights + 1
    local inEvent = (InstancingCmds and InstancingCmds.IsInInstance and InstancingCmds.IsInInstance() and InstancingCmds.GetInstanceID() == "HatchWar") == true
    local curCoins = GetCoins()
    print(string.format("[auto map] Zone %d || Round: %d || Boss: %s || Coins: %s || event: %s || cycle: %d",
        zoneNum, totalFights, info.Name, FormatNumber(curCoins), tostring(inEvent), currentCycle))

    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    local instancesFolder = pGui and pGui:FindFirstChild("_INSTANCES")
    local bossGui = instancesFolder and instancesFolder:FindFirstChild("HatchWarBoss")
    if bossGui then
        local tapHint = bossGui:FindFirstChild("TapHint")
        if tapHint then pcall(function() tapHint:Destroy() end) end
        local tth = bossGui:FindFirstChild("TapToHatch")
        if tth then tth.Visible = false end
    end

    local fightStart = os.clock()
    local maxFightDuration = 28

    task.spawn(function()
        while Running() and BossModule.IsFighting() and (os.clock() - fightStart < maxFightDuration) do
            if GetCoins() <= 0 then break end
            if CirclesModule and CirclesModule.TapOldest then
                while CirclesModule.TapOldest(function()
                    inst:FireCustom("HW_Boss_Tap", "circle")
                    if InputModule and InputModule.Count then
                        pcall(InputModule.Count)
                    end
                end) do
                end
            end
            task.wait(0.02)
        end
    end)

    while Running() and BossModule.IsFighting() do

        if os.clock() - fightStart >= maxFightDuration then
            print("[auto map] Boss timeout (28s) -> Exit.")
            break
        end

        if GetCoins() <= 0 then
            print("[auto map] Out of coins in boss -> Exit to farm.")
            break
        end

        inst:FireCustom("HW_Boss_Tap", "egg")
        if InputModule and InputModule.Count then
            pcall(InputModule.Count)
        end
        if SprayModule and SprayModule.Push then
            pcall(SprayModule.Push)
        end
        task.wait(0.05)
    end

    if skipCoinCheck then
        task.wait(0.35)
        ForceCleanupBossFight(true)
    else
        task.wait(1.5)
        ForceCleanupBossFight(false)
        runState.isFightingBoss = false
    end
    return true
end

