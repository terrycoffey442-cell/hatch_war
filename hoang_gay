local function PlaceFlagMaxSlots(flagId, uid, amount)
    if not amount or amount <= 0 or not uid then return false end
    local FlexibleFlagCmds = LoadModule(Client, "FlexibleFlagCmds")
    local MapCmdsMod = LoadModule(Client, "MapCmds")
    if not FlexibleFlagCmds or not FlexibleFlagCmds.Consume then return false end

    local targetZone = CONFIG.EndGame.TargetZone or 6
    local farmCF = GetZoneGroundCFrame(targetZone)
    local hrp = GetHRP()
    local originalCF = hrp and hrp.CFrame
    local wasAnchored = hrp and hrp.Anchored

    local inBox = MapCmdsMod and MapCmdsMod.IsInDottedBox and MapCmdsMod.IsInDottedBox()
    if not inBox or wasAnchored then
        if hrp then
            hrp.Anchored = false
            hrp.CFrame = farmCF
        end
        task.wait(0.4)
    end

    local ok, res = pcall(function()
        return FlexibleFlagCmds.Consume(flagId, uid, amount)
    end)

    if ok and res ~= false then
        print(string.format("[flags] Placed %d x %s", amount, flagId))
    else
        warn(string.format("[flags] Place %s failed: %s", flagId, tostring(res)))
    end

    if not inBox and originalCF and hrp then
        hrp.CFrame = originalCF
        task.wait(0.15)
        if wasAnchored then
            hrp.Anchored = true
        end
    end

    return ok and res ~= false
