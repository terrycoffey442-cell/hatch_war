        if isRealPlayerScript and isRealPlayerScript:IsA("ModuleScript") then
            local ok, isRealPlayerFunc = pcall(dynamicRequire, isRealPlayerScript)
            if ok and type(isRealPlayerFunc) == "function" and hookfunc then
                pcall(hookfunc, isRealPlayerFunc, function(...) return true end)
            end
        end
    end)

    -- 4. Hook Network.Invoke("Is Real Player") -> Luôn return true
    if Network and type(Network.Invoke) == "function" then
        local origInvoke = Network.Invoke
        if hookfunc then
            local rawInvoke
            rawInvoke = hookfunc(Network.Invoke, function(remoteName, ...)
                if remoteName == "Is Real Player" then
