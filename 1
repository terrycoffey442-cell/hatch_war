local function CheckAndBuyUpgrades(force)
    if not CONFIG.AutoUpgrade then return false end
    if IsBusy() and not force then return false end

    local UpgradesMod = LoadModule(Client.HatchWarCmds, "Upgrades")
    if not UpgradesMod and Client:FindFirstChild("HatchWarCmds") then
        pcall(function()
            UpgradesMod = dynamicRequire(Client.HatchWarCmds:FindFirstChild("Upgrades"))
        end)
    end
    if not UpgradesMod or not UpgradesMod.Tracks then return false end

    -- 1. Kiểm tra chính xác 100% bằng logic game: Có bất kỳ upgrade nào CanAfford() không?
    local affordableTracks = {}
    for _, track in ipairs(UpgradesMod.Tracks()) do
        if UpgradesMod.CanAfford and UpgradesMod.CanAfford(track) then
            table.insert(affordableTracks, track)
        end
    end

    -- NẾU KHÔNG CÓ BẤT KỲ NÂNG CẤP NÀO ĐỦ TIỀN MUA THÌ TUYỆT ĐỐI KHÔNG TELEPORT!
    if #affordableTracks == 0 then
        return false
    end

    -- 2. Ghi nhớ vị trí và trạng thái Anchor hiện tại
    local hrp = GetHRP()
    local returnCF = hrp and hrp.CFrame
    local wasAnchored = hrp and hrp.Anchored

    -- 3. Teleport đến đúng vị trí Pad của máy
    local machinePos = GetMachinePad()
    SafeTeleport(machinePos)
    task.wait(0.35)

    -- Đánh dấu Approached để server ghi nhận
    pcall(function()
        if Network and Network.Fire then
            Network.Fire("Machines: Mark Approached", "HatchWarUpgradeMachine")
        end
    end)

    -- 4. Batch Purchase: Mua lần lượt các upgrades đủ điều kiện
    local totalBought = 0
    for _, track in ipairs(affordableTracks) do
        local ok = false
        pcall(function()
            if EventUpgradeCmds and EventUpgradeCmds.Purchase then
                ok = EventUpgradeCmds.Purchase(track._id)
            elseif Network and Network.Invoke then
                ok = Network.Invoke("EventUpgrades: Purchase", track._id)
            end
        end)
        if ok then
            totalBought = totalBought + 1
            task.wait(0.12)
        end
    end

    -- Đóng GUI nếu bị mở
    pcall(function()
        local TabController = LoadModule(Client, "TabController")
        if TabController and TabController.CloseTab then
            TabController.CloseTab()
        end
    end)

    -- 5. Lập tức quay lại vị trí cũ và khôi phục hoạt động chiến đấu ngay, không để trễ damage
    if returnCF then
        SafeTeleport(returnCF)
        task.wait(0.15)
        local curHrp = GetHRP()
        if curHrp and wasAnchored then
            curHrp.Anchored = true
        end

        -- Phân phối lại ngay lập tức cho 15 pets và tap ngay để gây damage liên tục
        task.defer(function()
            local valid = GetZoneBreakables(CONFIG.EndGame.TargetZone or 6)
            local pets = GetLocalPets()
            if #valid > 0 and #pets > 0 then
                for i, pet in ipairs(pets) do
                    local t = valid[((i - 1) % #valid) + 1]
                    if t and t.Parent then
                        pcall(function() pet:SetTarget(t) end)
                    end
                end
            end
            local netDamage = game:GetService("ReplicatedStorage").Network:FindFirstChild("Breakables_PlayerDealDamage")
            if netDamage and #valid > 0 and valid[1].Parent then
                netDamage:FireServer(valid[1].Name)
            end
        end)
    end

    return totalBought > 0
end

-- 7.3. Tự động mua tối đa Egg Slots tại EggSlotsMachine khi đủ Diamonds & Rank
local function CheckAndBuyEggSlots()
    if not CONFIG.AutoBuyEggSlots then return end
    pcall(function()
        local SaveMod = LoadModule(Client, "Save")
        local RankCmds = LoadModule(Client, "RankCmds")
        local CurrencyCmds = LoadModule(Client, "CurrencyCmds")
        local Balancing = LoadModule(Library, "Balancing")

        if not SaveMod or not RankCmds or not Network then return end

        local save = SaveMod.Get()
        if not save then return end

        local purchased = save.EggSlotsPurchased or 0
        local maxPurchasable = (RankCmds.GetMaxPurchasableEggSlots and RankCmds.GetMaxPurchasableEggSlots()) or 0

        if purchased < maxPurchasable then
            local nextSlot = purchased + 1
            while nextSlot <= maxPurchasable and Running() do
                local bundleEnd, bundleSize, prevBundleEnd = RankCmds.GetEggBundle(nextSlot)
                if not bundleEnd or bundleEnd <= purchased then break end

                local cost = 0
                if Balancing and Balancing.CalcEggSlotPrice then
                    local startSlot = bundleEnd - bundleSize
                    for i = 1, bundleSize do
                        cost = cost + Balancing.CalcEggSlotPrice(startSlot + i)
                    end
                end

                local diamonds = (CurrencyCmds and CurrencyCmds.Get and CurrencyCmds.Get("Diamonds")) or 0
                if diamonds >= cost then
                    local success = Network.Invoke("EggHatchSlotsMachine_RequestPurchase", bundleEnd)
                    if success then
                        -- print(string.format("[egg slots] 🛒 Đã mua thành công +%d Egg Slot (Bundle %d) với %s Diamonds!", 
                        --     bundleSize, bundleEnd, FormatNumber(cost)))
                        purchased = bundleEnd
                        nextSlot = bundleEnd + 1
                        task.wait(0.2)
                    else
                        break
                    end
                else
                    break -- Không đủ Diamonds
                end
            end
        end
    end)
end

