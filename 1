local function IsActuallyInHatchWar()
    if not InstancingCmds then
        InstancingCmds = LoadModule(Client, "InstancingCmds")
    end
    if not InstancingCmds or not InstancingCmds.IsInInstance or not InstancingCmds.GetInstanceID then
        return false
    end

    local inInstance = InstancingCmds.IsInInstance()
    local currentId = InstancingCmds.GetInstanceID()
    if not inInstance or currentId ~= "HatchWar" then
        return false
    end

    -- Đã ở trong Instance HatchWar: Kiểm tra map container để đảm bảo world đã replicate
    local things = workspace:FindFirstChild("__THINGS")
    local container = things and things:FindFirstChild("__INSTANCE_CONTAINER")
    local active = container and container:FindFirstChild("Active")
    local hw = active and active:FindFirstChild("HatchWar")
    if not hw then
        return false
    end

    return true
end

local function EnsureInHatchWar()
    -- 1. Nếu đã ở trong Event và map đã tải hoàn tất: Trả về true ngay lập tức
    if IsActuallyInHatchWar() then
        return true
    end

    if not InstancingCmds then
        InstancingCmds = LoadModule(Client, "InstancingCmds")
    end

    -- Bảo vệ: Nếu InstancingCmds đã ghi nhận đang ở trong HatchWar, không gọi TriggerJoin tránh server reset map
    if InstancingCmds and InstancingCmds.IsInInstance and InstancingCmds.IsInInstance() and InstancingCmds.GetInstanceID and InstancingCmds.GetInstanceID() == "HatchWar" then
        return true
    end

    print("[event] 🚀 Chưa ở trong Event HatchWar! Đang tiến hành tham gia Event...")

    local function TriggerJoin()
        pcall(function()
            if InstancingCmds and InstancingCmds.Enter then
                InstancingCmds.Enter("HatchWar")
            end
        end)
        pcall(function()
            if Network and Network.Invoke then
                Network.Invoke("Instancing_PlayerEnterInstance", "HatchWar")
            end
        end)
    end

    TriggerJoin()

    -- 2. Vòng lặp chờ nạp bản đồ và đồng bộ nhân vật vào Event (Timeout 15 giây)
    local waitJoin = os.clock()
    local retried = false
    while Running() and (os.clock() - waitJoin < 15) do
        task.wait(0.5)
        if IsActuallyInHatchWar() then
            break
        end
        if (os.clock() - waitJoin > 6) and not retried then
            retried = true
            TriggerJoin()
        end
    end

    -- 3. Kiểm tra kết quả
    if IsActuallyInHatchWar() then
        task.wait(1.0) -- Đợi server và client đồng bộ ổn định
        print("[event] ✅ ĐÃ THAM GIA EVENT HATCHWAR THÀNH CÔNG (Bản đồ & Zones đã sẵn sàng)! Trả về true.")
        return true
    else
        warn("[event] ⚠️ Tham gia Event HatchWar thất bại hoặc chưa tải xong bản đồ!")
        return false
    end
end

local function InstallMissBypass(inst)
    if not inst or not inst.FireCustom then return end
    if inst._MissBypassed then return end
    inst._MissBypassed = true

    local rawFire = inst.FireCustom
    inst.FireCustom = function(self, name, ...)
        if tostring(name) == "HW_Boss_Miss" then
            return
        end
        return rawFire(self, name, ...)
    end
    RegisterPatch(inst, "FireCustom", rawFire)
end

