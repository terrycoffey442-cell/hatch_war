                local getcons = getconnections or get_signal_cons
                if type(getcons) == "function" then
                    for _, con in ipairs(getcons(openAnimSignal)) do
                        if con and con.Disable then
                            con:Disable()
                        elseif con and con.Disconnect then
                            con:Disconnect()
                        end
                    end
                end

                AddConnection(openAnimSignal:Connect(function(eggName, compressedPayload)
                    if not CONFIG.SilentHatch then return end
                    local uids = {}
                    if EggAnimPayload and EggAnimPayload.Decompress then
                        local decomp = EggAnimPayload.Decompress(compressedPayload)
                        if type(decomp) == "table" then
                            for uid, _ in pairs(decomp) do
                                table.insert(uids, uid)
                            end
                        end
                    end

                    -- Báo game unmask pet vào kho đồ ngay lập tức (0ms delay, không render model)
                    if #uids > 0 and Network.Fire then
                        Network.Fire("SM_Unmask", uids)
                    end
                    if Signal and Signal.Fire then
                        Signal.Fire("CompletedHatching", eggName, uids)
                    end
                end))
            end)
        end

        -- 4. Khóa camera người chơi không bị kéo/zoom vào trứng khi hatch
        AddConnection(workspace.CurrentCamera:GetPropertyChangedSignal("CameraType"):Connect(function()
            if CONFIG.SilentHatch and workspace.CurrentCamera.CameraType ~= Enum.CameraType.Custom then
                workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
            end
        end))
    end

    ApplySilentHatch()
end)

