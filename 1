local function CheckAndUnlockHouses(force)
    if not CONFIG.BloodMoon.AutoUnlockHouses then return false end
    if IsBusy() and not force then return false end

    local inst = GetHatchWarInstance()
    if not inst or not inst.InvokeCustom then return false end

    local housesSave = inst:GetSavedValue("Houses")
    local housesUnlocked = (HatchWarDoors and HatchWarDoors.Unlocked and HatchWarDoors.Unlocked(housesSave)) or 1
    if housesUnlocked >= 8 then return false end

    local nextHouse = housesUnlocked + 1
    local cost = (HatchWarDoors and HatchWarDoors.UnlockCost and HatchWarDoors.UnlockCost(nextHouse)) or math.huge
    local currentLollipops = GetLollipopCount()

    if currentLollipops >= cost then
        local spot = HOUSE_SPOTS[nextHouse]
        if not spot then return false end

        local hrp = GetHRP()
        local returnCF = hrp and hrp.CFrame
        local wasAnchored = hrp and hrp.Anchored

        print(string.format("[blood moon] 🗝️ Đủ Lollipops (%d/%d)! Tiến hành di chuyển tới Nhà %d để mở khóa...", currentLollipops, cost, nextHouse))
        SafeTeleport(spot)
        task.wait(0.65) -- Tăng thời gian chờ để server replicate network physics vị trí

        local ok, res, msg = pcall(function()
            return inst:InvokeCustom("HW_Doors_Unlock", nextHouse)
        end)

        -- Retry nếu server chưa kịp cập nhật vị trí
        if ok and res == false and tostring(msg):find("Walk up") then
            task.wait(0.5)
            ok, res, msg = pcall(function()
                return inst:InvokeCustom("HW_Doors_Unlock", nextHouse)
            end)
        end

        if ok and res ~= false then
            print(string.format("[blood moon] 🎉 Mở khóa thành công Nhà %d!", nextHouse))
        else
            warn(string.format("[blood moon] ⚠️ Mở khóa Nhà %d: %s", nextHouse, tostring(msg or res)))
        end
        task.wait(0.3)

        if returnCF then
            SafeTeleport(returnCF)
            task.wait(0.2)
            local curHrp = GetHRP()
            if curHrp and wasAnchored then
                curHrp.Anchored = true
            end
        end
        return ok and res ~= false
    end
    return false
end

local function CheckAndKnockDoors(force)
    if not CONFIG.BloodMoon.AutoKnock then return false end
    if IsBusy() and not force then return false end
    local inst = GetHatchWarInstance()
    if not inst or not inst.InvokeCustom then return false end

    local moonState = GetBloodMoonState()
    local isBloodMoon = (moonState == "up")
    if CONFIG.BloodMoon.OnlyInBloodMoon and not isBloodMoon then
        return false
    end

    local doorsSave = inst:GetSavedValue("Doors")
    local housesSave = inst:GetSavedValue("Houses")
    local maxHouse = (HatchWarDoors and HatchWarDoors.Unlocked and HatchWarDoors.Unlocked(housesSave)) or 1
    local now = workspace:GetServerTimeNow()
    local curCoins = GetCoins()

    -- Thứ tự ưu tiên: Nếu đang Blood Moon thì ưu tiên Nhà 8, 7 trước (để săn Huge & Titanic)
    local order = {}
    if isBloodMoon and CONFIG.BloodMoon.PrioritizeHouses7And8 then
        for h = maxHouse, 1, -1 do
            table.insert(order, h)
        end
    else
        for h = 1, maxHouse do
            table.insert(order, h)
        end
    end

    local knockedAny = false
    local hrp = GetHRP()
    local returnCF = hrp and hrp.CFrame
    local wasAnchored = hrp and hrp.Anchored

    for _, houseNum in ipairs(order) do
        local cdEnd = (HatchWarDoors and HatchWarDoors.CooldownEnd and HatchWarDoors.CooldownEnd(doorsSave, houseNum)) or 0
        if now >= cdEnd then
            local knockCost = (HatchWarDoors and HatchWarDoors.KnockCost and HatchWarDoors.KnockCost(houseNum)) or 1_000_000
            if curCoins >= knockCost then
                local spot = HOUSE_SPOTS[houseNum]
                if spot then
                    SafeTeleport(spot)
                    task.wait(0.2)
                end

                local ok, res = pcall(function()
                    return inst:InvokeCustom("HW_Doors_Knock", houseNum)
                end)
                if ok and res ~= false then
                    knockedAny = true
                    print(string.format("[blood moon] 🚪 Gõ Cửa Nhà %d thành công! (BloodMoon: %s)", houseNum, tostring(isBloodMoon)))
                    task.wait(0.3)
                end
            end
        end
    end

    if knockedAny and returnCF then
        SafeTeleport(returnCF)
        task.wait(0.15)
        local curHrp = GetHRP()
        if curHrp and wasAnchored then
            curHrp.Anchored = true
        end
    end
    return knockedAny
end

local function CheckAndOpenPumpkin(force)
    if not CONFIG.BloodMoon.AutoPumpkin then return false end
    if IsBusy() and not force then return false end
    local inst = GetHatchWarInstance()
    if not inst or not inst.InvokeCustom then return false end

    local pumpkinSave = inst:GetSavedValue("Pumpkin")
    local points = pumpkinSave and pumpkinSave.Points or 0
    local bosses = GetCurrentMaxUnlockedZone() or 1
    local cap = (HatchWarPumpkin and HatchWarPumpkin.Cap and HatchWarPumpkin.Cap(bosses)) or 4000
    local opens = (HatchWarPumpkin and HatchWarPumpkin.OpensFor and HatchWarPumpkin.OpensFor(points, cap)) or 0

    if opens > 0 then
        local hrp = GetHRP()
        local returnCF = hrp and hrp.CFrame
        local wasAnchored = hrp and hrp.Anchored

        SafeTeleport(PUMPKIN_SPOT)
        task.wait(0.25)

        local ok, res = pcall(function()
            return inst:InvokeCustom("HW_Pumpkin_Open")
        end)
        if ok and res ~= false then
            print(string.format("[pumpkin] 🎃 Mở Giant Pumpkin thành công (x%d Opens, Points: %s/%s)!", 
                opens, FormatNumber(points), FormatNumber(cap)))
            task.wait(0.3)
        end

        if returnCF then
            SafeTeleport(returnCF)
            task.wait(0.15)
            local curHrp = GetHRP()
            if curHrp and wasAnchored then
                curHrp.Anchored = true
            end
        end
        return true
    end
    return false
end

