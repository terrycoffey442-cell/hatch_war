-- ============================================================================
local lastBoosterCheck = 0
local lastSpellUsedRound = -1
local function AutoUseEventBoosters()
    if os.clock() - lastBoosterCheck < 2.5 then return end
    lastBoosterCheck = os.clock()

    local Save = LoadModule(Client, "Save")
    local save = Save and Save.Get and Save.Get()
    if not save or not Network then return end

    local inventory = (save.Inventory and save.Inventory.Consumable) or {}
    local Bursts = LoadModule(Util, "HatchWarBursts")

    -- Helper tìm item trong túi: ưu tiên dùng Tier 1 trước để tiết kiệm Tier cao
    local function FindConsumable(targetId)
        local candidates = {}
        for uid, item in pairs(inventory) do
            if item and item.id == targetId and (item._am or 1) > 0 then
                local tier = tonumber(item.tn or item.tier) or 1
                table.insert(candidates, { uid = uid, tier = tier, amount = item._am or 1 })
            end
        end
        if #candidates == 0 then return nil end
        table.sort(candidates, function(a, b) return a.tier < b.tier end)
        return candidates[1]
    end

    -- CHẾ ĐỘ 1: ĐÁNH BOSS (EndGame.Boss == true hoặc đang trong boss battle)
    -- Sử dụng: "Lucky Spell" (x2/x3 Luck cho Win Chance & mọi trứng nở trong Boss)
    -- Spell nạp cho TRẬN BOSS TIẾP THEO -> Chỉ dùng 1 lần cho mỗi hiệp đánh boss (tránh spam lặp lại)
    if CONFIG.EndGame.Boss == true or runState.isFightingBoss == true then
        local currentFightNum = totalFights or 0
        if currentFightNum ~= lastSpellUsedRound then
            lastSpellUsedRound = currentFightNum
            local item = FindConsumable("Lucky Spell")
            if item then
                print(string.format("[booster] 🔮 Tự động dùng 'Lucky Spell' (Tier %d) cho Boss Fight! (Còn trong kho: %d)", 
                    item.tier, item.amount))
                pcall(function()
                    Network.Invoke("Consumables_Consume", item.uid, 1)
                end)
            end
        end
    end

    -- CHẾ ĐỘ 2: MỞ TRỨNG (EndGame.Hatch == true hoặc đang trong chu kỳ hatch)
    -- Sử dụng: "Soul Lantern" (Internal ID: "Lucky Brew", x3/x5 Luck cho toàn bộ trứng Hatch Wars)
    -- Brew kéo dài theo thời gian (60s mỗi lần) -> Chỉ dùng khi chưa có buff hoặc hết thời gian
    if CONFIG.EndGame.Hatch == true or runState.isHatching == true then
        local brewTier = Bursts and Bursts.BestArmed and Bursts.BestArmed(LocalPlayer, "Brew") or 0
        if brewTier == 0 then
            local item = FindConsumable("Lucky Brew")
            if item then
                print(string.format("[booster] 🏮 Tự động thắp 'Soul Lantern' (Tier %d) cho Hatching! (Còn trong kho: %d)", 
                    item.tier, item.amount))
                pcall(function()
                    Network.Invoke("Consumables_Consume", item.uid, 1)
                end)
            end
        end
    end
end

