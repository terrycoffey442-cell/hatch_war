local lastFlagCheck = 0

local function GetCurrentFlagContext()
    local MapCmdsMod = LoadModule(Client, "MapCmds")
    local instInfo = MapCmdsMod and MapCmdsMod.GetCurrentInstanceInfo and MapCmdsMod.GetCurrentInstanceInfo()
    local BreakablesTypes = LoadModule(Types, "Breakables")
    if instInfo then
        local pType = (BreakablesTypes and BreakablesTypes.ParentType and BreakablesTypes.ParentType.Instance) or 2
        return pType, instInfo.InstanceId, instInfo.AreaId
    end
    local pType = (BreakablesTypes and BreakablesTypes.ParentType and BreakablesTypes.ParentType.Zone) or 1
    local currentZone = (MapCmdsMod and MapCmdsMod.GetCurrentZone and MapCmdsMod.GetCurrentZone()) or "Spawn"
    return pType, currentZone, nil
end

local function FindFlagInInventory(targetFlagId)
    local Save = LoadModule(Client, "Save")
    local save = Save and Save.Get and Save.Get()
    local misc = save and save.Inventory and save.Inventory.Misc
    if not misc then return nil end

    for uid, item in pairs(misc) do
        if item and item.id == targetFlagId and (item._am or 1) > 0 then
            return { uid = uid, amount = item._am or 1 }
        end
    end
    return nil
end

local function PlaceFlagMaxSlots(flagId, uid, amount)
    if not amount or amount <= 0 or not uid then return false end
    local FlexibleFlagCmds = LoadModule(Client, "FlexibleFlagCmds")
    local MapCmdsMod = LoadModule(Client, "MapCmds")
    if not FlexibleFlagCmds or not FlexibleFlagCmds.Consume then return false end

    local targetZone = CONFIG.EndGame.TargetZone or 6
    local farmCF = GetZoneGroundCFrame(targetZone)
    local hrp = GetHRP()
    local originalCF = hrp and hrp.CFrame
    local wasAnchored = hrp and hrp.Anchored

    -- Server bắt buộc nhân vật phải unanchored và đứng bên trong bãi breakables (IsInDottedBox)
    local inBox = MapCmdsMod and MapCmdsMod.IsInDottedBox and MapCmdsMod.IsInDottedBox()
    if not inBox or wasAnchored then
        if hrp then
            hrp.Anchored = false
            hrp.CFrame = farmCF
        end
        task.wait(0.4) -- Đợi replication physics đồng bộ vị trí lên server
    end

    local ok, res = pcall(function()
        return FlexibleFlagCmds.Consume(flagId, uid, amount)
    end)

    if ok and res ~= false then
        print(string.format("[flags] 🚩 Đã cắm thành công %d x '%s' (Max Slots)! Tiếp tục farm...", amount, flagId))
    else
        warn(string.format("[flags] ⚠️ Cắm cờ '%s' thất bại: %s", flagId, tostring(res)))
    end

    -- Khôi phục vị trí cũ nếu trước đó đang ở vị trí khác (như Boss spot hoặc Egg spot)
    if not inBox and originalCF and hrp then
        hrp.CFrame = originalCF
        task.wait(0.15)
        if wasAnchored then
            hrp.Anchored = true
        end
    end

    return ok and res ~= false
end

local function AutoManageFlags()
    if not CONFIG.AutoFlags then return end
    if os.clock() - lastFlagCheck < 5.0 then return end
    lastFlagCheck = os.clock()

    local FlexibleFlagCmds = LoadModule(Client, "FlexibleFlagCmds")
    if not FlexibleFlagCmds then return end

    local BossMod = LoadModule(Client.HatchWarCmds, "Boss")
    if BossMod and BossMod.IsFighting and BossMod.IsFighting() then
        return
    end

    local pType, pId, aId = GetCurrentFlagContext()
    local activeFlag = FlexibleFlagCmds.GetActiveFlag and FlexibleFlagCmds.GetActiveFlag(pType, pId, aId)
    local now = workspace:GetServerTimeNow()
    local timeLeft = activeFlag and (activeFlag.EndTime - now) or 0

    -- TRƯỜNG HỢP 1: TRÊN MAP ĐANG CÓ CỜ ACTIVE (timeLeft > 0)
    if activeFlag and timeLeft > 0 then
        local activeId = activeFlag.FlagId
        -- Nếu cờ đang cắm là Fortune Flag hoặc Coins Flag:
        if activeId == "Fortune Flag" or activeId == "Coins Flag" then
            local slotsNeeded = FlexibleFlagCmds.GetMaxPlace and FlexibleFlagCmds.GetMaxPlace(activeId, pType, pId, aId) or 0
            -- Nếu còn thiếu slots để đạt Max Slots: Cắm nốt 1 lần duy nhất
            if slotsNeeded > 0 then
                local item = FindFlagInInventory(activeId)
                if item and item.amount > 0 then
                    local amountToPlace = math.min(slotsNeeded, item.amount)
                    PlaceFlagMaxSlots(activeId, item.uid, amountToPlace)
                end
            end
            -- Đã full slots (hoặc vừa cắm xong): Farm cho đến khi timeLeft <= 0 mới can thiệp tiếp
            return
        else
            -- Cờ khác trên map (không đè được): chờ hết hạn
            return
        end
    end

    -- TRƯỜNG HỢP 2: TRÊN MAP CHƯA CÓ CỜ HOẶC CỜ CŨ ĐÃ HẾT HẠN (timeLeft <= 0)
    -- Quy tắc ưu tiên: Ưu tiên "Fortune Flag", nếu không có thì dùng "Coins Flag"
    local selectedFlag = nil
    local fortuneItem = FindFlagInInventory("Fortune Flag")
    local coinsItem = FindFlagInInventory("Coins Flag")

    if fortuneItem and fortuneItem.amount > 0 then
        selectedFlag = { id = "Fortune Flag", uid = fortuneItem.uid, amount = fortuneItem.amount }
    elseif coinsItem and coinsItem.amount > 0 then
        selectedFlag = { id = "Coins Flag", uid = coinsItem.uid, amount = coinsItem.amount }
    end

    if not selectedFlag then
        return -- Không còn cờ nào trong kho đồ
    end

    local maxSlots = FlexibleFlagCmds.GetMaxPlace and FlexibleFlagCmds.GetMaxPlace(selectedFlag.id, pType, pId, aId) or 0
    if maxSlots <= 0 then
        maxSlots = 24 -- Fallback theo chuẩn game
    end

    local amountToPlace = math.min(maxSlots, selectedFlag.amount)
    if amountToPlace > 0 then
        PlaceFlagMaxSlots(selectedFlag.id, selectedFlag.uid, amountToPlace)
    end
end

