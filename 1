local function GetZoneBreakables(zoneNum)
    local valid = {}
    local things = workspace:FindFirstChild("__THINGS")
    local bFolder = things and things:FindFirstChild("Breakables")
    if not bFolder then return valid end

    local targetCF = GetZoneGroundCFrame(zoneNum or 6)
