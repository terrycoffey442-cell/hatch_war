local function HasAutoFarmGamepass()
    -- 1. Check trực tiếp Client.Gamepasses.Owns("Auto Farm")
    local Gamepasses = LoadModule(Client, "Gamepasses")
    if Gamepasses and Gamepasses.Owns then
        local ok, owns = pcall(Gamepasses.Owns, "Auto Farm")
        if ok and owns == true then
            return true
        end
        -- Thử với table entry nếu có require Directory.Gamepasses
        local GamepassesDir = LoadModule(Directory, "Gamepasses")
        if GamepassesDir then
            local okEntry, gpEntry = pcall(function() return GamepassesDir["Auto Farm"] end)
            if okEntry and gpEntry then
                local ok2, owns2 = pcall(Gamepasses.Owns, gpEntry)
                if ok2 and owns2 == true then
                    return true
                end
            end
        end
    end

    -- 2. Check Instance Config (chuẩn từ AutoFarmCmds: InstancingCmds.Get().config.FreeAutoFarm)
    local inst = InstancingCmds and InstancingCmds.Get and InstancingCmds.Get()
    if inst and inst.config and inst.config.FreeAutoFarm == true then
        return true
    end

    -- 3. Check Save Data fallback
    local save = (SaveMod and SaveMod.Get and SaveMod.Get()) or (Saving and Saving.Get and Saving.Get())
    if save and save.Gamepasses then
        local GamepassesDir = LoadModule(Directory, "Gamepasses")
        local gpEntry = GamepassesDir and GamepassesDir["Auto Farm"]
        local prodId = gpEntry and gpEntry.ProductId
        if save.Gamepasses["Auto Farm"] or save.Gamepasses["AutoFarm"] or (prodId and save.Gamepasses[prodId]) then
            return true
        end
    end
    return false
end

-- Helper tìm Part mặt đất thực tế của Zone (An toàn tuyệt đối cho mọi loại Instance)
local function GetZoneGroundPart(zoneNum)
    local zNum = tonumber(zoneNum) or 6
    local things = workspace:FindFirstChild("__THINGS")
    
    -- 1. Ưu tiên tìm trong __FAKE_INSTANCE_BREAK_ZONES (Part chuẩn)
    local fakeBreakZones = things and things:FindFirstChild("__FAKE_INSTANCE_BREAK_ZONES")
    if fakeBreakZones then
        for _, folder in ipairs(fakeBreakZones:GetChildren()) do
            local p = folder:FindFirstChild("Zone" .. tostring(zNum))
            if p and p:IsA("BasePart") then
                return p
            end
        end
    end

    -- 2. Tìm trong ZONE_GROUND của Event Model
    local container = things and things:FindFirstChild("__INSTANCE_CONTAINER")
    local active = container and container:FindFirstChild("Active")
    local hw = active and active:FindFirstChild("HatchWar")
    local zg = hw and hw:FindFirstChild("ZONE_GROUND")
    if zg then
        local p = zg:FindFirstChild(tostring(zNum))
        if p and p:IsA("BasePart") then
            return p
        end
    end

    -- 3. Fallback lấy Part con bên trong breakableZones
    local inst = GetHatchWarInstance()
    local bz = inst and inst.breakableZones and inst.breakableZones:FindFirstChild("Zone" .. tostring(zNum))
    if bz then
        if bz:IsA("BasePart") then
            return bz
        elseif bz:IsA("Model") then
            return bz.PrimaryPart or bz:FindFirstChildWhichIsA("BasePart") or bz
        elseif bz:IsA("Folder") then
            return bz:FindFirstChildWhichIsA("BasePart")
        end
    end
    return nil
end

local function GetZoneGroundCFrame(zoneNum)
    local p = GetZoneGroundPart(zoneNum)
    if p then
        if p:IsA("BasePart") then
            return p.CFrame + Vector3.new(0, 3, 0)
        elseif p:IsA("Model") then
            return p:GetPivot() + Vector3.new(0, 3, 0)
        end
    end
    -- Fallback tọa độ gốc Zone 6 chuẩn
    if tonumber(zoneNum) == 6 then
        return CFrame.new(7540.8, 16.5, 21998.2)
    end
    return CFrame.new(7540.8, 16.5, 21998.2)
end

