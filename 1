currentCycle = currentCycle or 1

local function ClearCycleCache(cycleNum)
    local cNum = cycleNum or currentCycle

    -- 1. Giải phóng UI & Lock của Boss Fight
    ForceCleanupBossFight()

    -- 2. Đóng toàn bộ GUI rác trong PlayerGui nếu còn sót lại
    pcall(function()
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        if pGui then
            local instances = pGui:FindFirstChild("_INSTANCES")
            if instances then
                for _, child in ipairs(instances:GetChildren()) do
                    if child.Name:find("Boss") or child.Name:find("Egg") or child.Name:find("Hatch") then
                        child.Enabled = false
                    end
                end
            end
        end
    end)

    -- 3. Mở neo tạm thời trước khi chuẩn bị di chuyển về bãi farm
    local hrp = GetHRP()
    if hrp then
        hrp.Anchored = false
    end

    -- 4. Kích hoạt dọn rác bộ nhớ Lua (Lua GC)
    pcall(function()
        collectgarbage("count")
    end)

    task.wait(0.3)
end

local function PerformEventIntermissions()
    -- 1. Ưu tiên mở khóa Nhà mới liên tục nếu đủ Lollipops (mở hết các nhà có thể mua)
    while CheckAndUnlockHouses(true) do
        task.wait(0.3)
    end

    -- 2. Ưu tiên gõ cửa nếu có cửa hết cooldown (nhất là trong Blood Moon)
    CheckAndKnockDoors(true)

    -- 3. Mở Giant Pumpkin nếu đã tích đầy
    CheckAndOpenPumpkin(true)

    -- 4. Định kỳ kiểm tra mua Upgrades nếu đến chu kỳ
    if CONFIG.AutoUpgrade and (os.clock() - lastUpgradeCheck > CONFIG.UpgradeCheckInterval) then
        lastUpgradeCheck = os.clock()
        CheckAndBuyUpgrades(true)
    end
end

local function BossEndGameCycleLoop(targetZone)
    -- BẢO VỆ GAMEPASS: Acc có gp chỉ được bật isFightingBoss khi Auto Farm đã thực sự đặt xong (res == true)
    if HasAutoFarmGamepass() then
        local afReady = AutoFarmCmds and AutoFarmCmds.IsEnabled and AutoFarmCmds.IsEnabled()
        if not afReady or lastAutoFarmZone ~= targetZone then
            local afOk = EnsureAutoFarmActiveAtZone(targetZone)
            if not afOk then
                warn(string.format("[auto boss] ⚠️ Auto Farm chưa kích hoạt xong tại Zone %d (res: false) -> Hoãn chu kỳ Boss!", targetZone))
                return 0
            end
        end
    end

    runState.isFightingBoss = true
    local info = BOSS_INFO[targetZone]
    local minCoinsToFight = info and info.MinCoins or 98000
    local fightCountInCycle = 0
    local cycleStartCoins = GetCoins()

    -- Đảm bảo trước khi vào chu kỳ đánh boss liên tục, nhân vật đã ở bossSpot và neo chặt
    local inst = GetHatchWarInstance()
    local bossSpot = info and info.Spot
    local bFolder = inst and inst.model and inst.model:FindFirstChild("INTERACT")
        and inst.model.INTERACT:FindFirstChild("Bosses")
        and inst.model.INTERACT.Bosses:FindFirstChild("Boss" .. tostring(targetZone))
    if bFolder and bFolder:FindFirstChild("Idle") then
        bossSpot = bFolder.Idle.CFrame + Vector3.new(0, 2, 0)
    end
    if bossSpot then
        local hrp = GetHRP()
        if not hrp or (hrp.Position - bossSpot.Position).Magnitude > 6 then
            SafeTeleport(bossSpot)
            task.wait(0.3)
        end
        hrp = GetHRP()
        if hrp then hrp.Anchored = true end
    end

    -- [DUAL BACKGROUND FARM ENGINE - VỪA ĐÁNH BOSS VỪA CÀY COIN ZONE 6]:
    -- Giải quyết triệt để: Pets liên tục cày nát bãi Zone 6 + Auto Tap 20Hz mang coin về bù chi phí đánh boss
    local bossFarmActive = true
    local netDamage = game:GetService("ReplicatedStorage").Network:FindFirstChild("Breakables_PlayerDealDamage")

    -- Worker 1: Target-Focused Auto Tap Engine (14Hz) cày breakables Zone 6 liên tục
    StartAutoTapWorker(targetZone, function()
        return bossFarmActive
    end)

    -- Worker 2: Smart Pet 999 Remote Dispatcher (5Hz) liên tục xua 15 Pets ra cắn nát breakables Zone 6
    task.spawn(function()
        while Running() and bossFarmActive do
            local valid = GetZoneBreakables(targetZone)
            local pets = GetLocalPets()

            if #valid > 0 and #pets > 0 then
                for i, pet in ipairs(pets) do
                    local targetBreakable = valid[((i - 1) % #valid) + 1]
                    if targetBreakable and targetBreakable.Parent then
                        pcall(function()
                            if pet:GetTarget() ~= targetBreakable then
                                pet:SetTarget(targetBreakable)
                            end
                        end)
                    end
                end
            end
            task.wait(0.18)
        end
    end)

    while Running() and GetCoins() >= minCoinsToFight do
        fightCountInCycle = fightCountInCycle + 1

        -- Tự động duy trì Event Boosters (Halloween Lucky Egg & Trick or Treat Luck)
        AutoUseEventBoosters()

        local success = FightBossAtZone(targetZone, true) -- true: skipCoinCheck (không chạy về bãi cày giữa chừng)

        if not success then
            -- Nếu kích hoạt trận không thành công (boss chưa idle hoặc server bận), chờ 1s thử lại
            task.wait(1.0)
        else
            -- Sau khi kết thúc trận, chờ cực ngắn (0.25s) cho server reset state mà không mất time
            task.wait(0.25)
        end

        -- [INTERMISSION]: Kiểm tra từ xa & xử lý sự kiện ưu tiên (Unlock nhà / Gõ cửa / Pumpkin / Upgrade)
        PerformEventIntermissions()

        -- Nếu coin sau trận đã giảm xuống dưới minCoinsToFight thì dừng chu kỳ
        if GetCoins() < minCoinsToFight then
            break
        end
    end

    bossFarmActive = false
    runState.isFightingBoss = false
    return fightCountInCycle
end

local function HatchEndGameCycleLoop()
    -- BẢO VỆ GAMEPASS: Acc có gp chỉ được chạy Hatch khi Auto Farm đã thực sự đặt xong (res == true)
    if HasAutoFarmGamepass() then
        local targetZone = CONFIG.EndGame.TargetZone or 6
        local afReady = AutoFarmCmds and AutoFarmCmds.IsEnabled and AutoFarmCmds.IsEnabled()
        if not afReady or lastAutoFarmZone ~= targetZone then
            local afOk = EnsureAutoFarmActiveAtZone(targetZone)
            if not afOk then
                warn(string.format("[auto hatch] ⚠️ Auto Farm chưa kích hoạt xong tại Zone %d (res: false) -> Hoãn chu kỳ Hatch!", targetZone))
                return 0
            end
        end
    end

    runState.isHatching = true
    if not CustomEggsCmds or not Network then
        runState.isHatching = false
        task.wait(1)
        return 0
    end

    -- 1. Tự động kiểm tra mua Max Egg Slots khi có Diamonds trước khi vào chu kỳ Hatch
    CheckAndBuyEggSlots()

    -- 2. Tự động kích hoạt Event Boosters (Halloween Lucky Egg)
    AutoUseEventBoosters()

    -- Vị trí đứng: Neo ngay trước bệ trứng mục tiêu (Manor Egg / Werewolf Egg / Witching Egg)
    local eggName = CONFIG.EndGame.EggName or "Manor Egg"
    local HATCH_STAND_CFRAME = EGG_STAND_CFRAMES[eggName] or (CONFIG.EndGame.EggSpot and CFrame.new(CONFIG.EndGame.EggSpot + Vector3.new(0, -4.8, 4))) or CFrame.new(7537.25, 16.5, 21943.0)
    SafeTeleport(HATCH_STAND_CFRAME)
    task.wait(0.3)
    local hrp = GetHRP()
    if hrp then hrp.Anchored = true end

    local eggUid = CustomEggsCmds.GetClosestById and CustomEggsCmds.GetClosestById(CONFIG.EndGame.EggName)
    local eggUnitPrice = 98000 -- Fallback giá 1 quả trứng
    pcall(function()
        local CalcEggPricePlayer = LoadModule(Library, "Balancing.CalcEggPricePlayer")
        local eggData = eggUid and CustomEggsCmds.Get(eggUid)
        if eggData and CalcEggPricePlayer then
            eggUnitPrice = CalcEggPricePlayer(eggData:Directory()) or 98000
        end
    end)

    -- Lấy maxHatch động từ EggCmds thay vì fix cứng 88
    local maxHatch = (EggCmds and EggCmds.GetMaxHatch and EggCmds.GetMaxHatch()) or 8
    local hatchBatches = 0
    local lastHatchPrint = 0
    local hatchFarmActive = true
    local netDamage = game:GetService("ReplicatedStorage").Network:FindFirstChild("Breakables_PlayerDealDamage")
    local targetFarmZone = CONFIG.EndGame.TargetZone or 6

    -- [WORKER 1 - VỪA HATCH VỪA FARM]: Target-Focused Auto Tap Engine (14Hz) song song trong lúc mở trứng
    StartAutoTapWorker(targetFarmZone, function()
        return hatchFarmActive
    end)

    -- [WORKER 2 - VỪA HATCH VỪA FARM]: Phân phối 15 Pet Speed 999 cắn breakables Zone song song trong lúc mở trứng
    task.spawn(function()
        while Running() and hatchFarmActive do
            local valid = GetZoneBreakables(targetFarmZone)
            local pets = GetLocalPets()

            if #valid > 0 and #pets > 0 then
                for i, pet in ipairs(pets) do
                    local targetBreakable = valid[((i - 1) % #valid) + 1]
                    if targetBreakable and targetBreakable.Parent then
                        pcall(function()
                            if pet:GetTarget() ~= targetBreakable then
                                pet:SetTarget(targetBreakable)
                            end
                        end)
                    end
                end
            end
            task.wait(0.15)
        end
    end)

    -- [VÒNG LẶP MỞ TRỨNG CHÍNH - MỞ LIÊN TỤC CHO ĐẾN KHI HẾT COIN]
    local failedStreak = 0
    while Running() and GetCoins() >= eggUnitPrice do
        if not eggUid then
            eggUid = CustomEggsCmds.GetClosestById and CustomEggsCmds.GetClosestById(CONFIG.EndGame.EggName)
        end

        local curCoins = GetCoins()
        maxHatch = (EggCmds and EggCmds.GetMaxHatch and EggCmds.GetMaxHatch()) or maxHatch

        -- TÍNH TOÁN ĐỘNG: Nếu coin < giá maxHatch quả, tự động giảm xuống số quả có thể mua được!
        local maxAffordable = math.floor(curCoins / eggUnitPrice)
        local batchAmount = math.min(maxHatch, maxAffordable)

        if batchAmount <= 0 then
            break -- Thực sự không đủ tiền mở dù chỉ 1 quả
        end

        local success = false
        if eggUid then
            local ok, res = pcall(function()
                return Network.Invoke("CustomEggs_Hatch", eggUid, batchAmount)
            end)
            if ok and res ~= false then
                success = true
                failedStreak = 0
                hatchBatches = hatchBatches + 1
            else
                failedStreak = failedStreak + 1
            end
        end

        if not success and failedStreak >= 2 then
            -- Nếu có lỗi hoặc bị server đẩy lùi, snap lại vị trí chuẩn ngay trước bệ trứng
            SafeTeleport(HATCH_STAND_CFRAME)
            task.wait(0.2)
        end

        task.wait(0.12)

        if os.clock() - lastHatchPrint > 3 or hatchBatches == 1 then
            lastHatchPrint = os.clock()
            print(string.format("[auto map] Zone %d || Hatch: #%d (x%d) || %s || Coins: %s || cycle: %d", 
                CONFIG.EndGame.TargetZone or 6, hatchBatches, batchAmount, CONFIG.EndGame.EggName, FormatNumber(GetCoins()), currentCycle))
        end
    end

    -- Kết thúc chu kỳ mở trứng
    hatchFarmActive = false
    task.wait(0.1)
    hrp = GetHRP()
    if hrp then hrp.Anchored = false end

    runState.isHatching = false
    return hatchBatches
end

