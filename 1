local runState = { 
    alive = true,
    isFightingBoss = false,
    isHatching = false,
}
local connections = {}
local patches = {}
local BossModule = nil
local ConsumableCmds = nil

local function Running()
    return runState.alive and getgenv().AutoMapRunning == true
end

local function IsBusy()
    if runState.isFightingBoss == true or runState.isHatching == true then
        return true
    end
    if BossModule and BossModule.IsFighting and BossModule.IsFighting() == true then
        return true
    end
    return false
end

local function AddConnection(conn)
    if conn then table.insert(connections, conn) end
    return conn
end

local function RegisterPatch(tbl, key, original)
    if tbl and key ~= nil then
        table.insert(patches, { module = tbl, key = key, original = original })
    end
end

local function SafePatch(tbl, key, newFunc)
    if not tbl or not key or not newFunc then return end
    pcall(function()
        if setreadonly then setreadonly(tbl, false) end
        if make_writeable then make_writeable(tbl) end
    end)
    local original = tbl[key]
    local success = pcall(function()
        tbl[key] = newFunc
    end)
    if success and original then
        RegisterPatch(tbl, key, original)
    end
end

local function Teardown()
    runState.alive = false
    getgenv().AutoMapRunning = false
    for i = #connections, 1, -1 do
        pcall(function() connections[i]:Disconnect() end)
        connections[i] = nil
    end
    for i = #patches, 1, -1 do
        local p = patches[i]
        if p and p.module then
            pcall(function() p.module[p.key] = p.original end)
        end
        patches[i] = nil
    end
end
getgenv().AutoMapStop = Teardown

